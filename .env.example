# 复制为 .env 后按需修改；.env 含密钥，已被 .gitignore 忽略，请勿提交

# AI 模型配置（OpenAI 兼容接口，必填 KEY 与 NAME 后 Agent Service 才可用）
AI_MODEL_API_KEY=your-api-key
AI_MODEL_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL_NAME=your-model-name

# 服务端口
PORT=3100

# 编辑器后端地址：用于调用 validateTagItem 补全特性条件测点的模型信息（nodeType/itemType/_unique 等）；留空则跳过补全
HMI_EDITOR_SVC_URL=

# 最大重试次数
AI_MODEL_API_MAX_RETRIES=3
AI_MODEL_API_RETRY_DELAY=10000
AI_MODEL_API_RETRY_MAX_DELAY=120000
AI_MODEL_API_RATE_LIMIT_RETRY_DELAY=60000

# 思考控制：默认保留完整思考（质量优先）。输出额度默认 32768，思考耗尽后自动放宽到最多 65536 重试。
# 以下为可选项：AI_MODEL_FALLBACK_BODY 为思考耗尽重试时附加的网关参数（如 DeepSeek 关闭思考 {"thinking":{"type":"disabled"}}，会降低质量，默认不启用）；
# AI_MODEL_MAX_REASONING_CHARS 为无输出时允许的最大思考长度，超过则提前中断，0 为不限制
# AI_MODEL_FALLBACK_BODY={"thinking":{"type":"disabled"}}
AI_MODEL_MAX_TOKENS=32768
AI_MODEL_MAX_REASONING_CHARS=0

# 方案预览（几秒内先展示整体方案）：预览调用附加的参数，DeepSeek 系关闭思考；其它模型请按其网关参数调整或删除
# AI_MODEL_PREVIEW_BODY={"thinking":{"type":"disabled"}}

# MCP 入口（/mcp/display、/mcp/symbol）：MCP_ENABLED=false 时关闭
MCP_ENABLED=true
# 设置后，MCP 请求必须带请求头 x-mcp-token（Authorization 仍透传给编辑器网关，不用于此校验）
# MCP_AUTH_TOKEN=
# 带 Origin 头的请求必须命中该名单，逗号分隔；不配置则不校验
# MCP_ALLOWED_ORIGINS=https://editor.example.com
# 最大并发 MCP 会话数（默认 100）与闲置回收时间（毫秒，默认 1800000 即 30 分钟）
MCP_MAX_SESSIONS=100
MCP_SESSION_TTL_MS=1800000
# 服务对外可访问的源地址（不含 /mcp），用于生成结果下载链接，例如 https://hmi.example.com；云端部署务必填写，留空则从请求头推断（本地可留空）
MCP_PUBLIC_BASE_URL=
# 结果下载链接有效期（毫秒，默认 600000 即 10 分钟）与最多缓存的结果数（默认 100）
MCP_RESULT_TTL_MS=600000
MCP_MAX_RESULTS=100
# MCP 查询点信息（validateTagItem）配置，均可留空：
# 优先读取 mcp.json headers 中的 editorSvcUrl / editorAuthorization / projectCode，未提供时才使用下面的环境变量
# 地址未配置时跳过测点补全
# MCP_EDITOR_SVC_URL=
# 完整的 Authorization 请求头值
# MCP_EDITOR_AUTHORIZATION=
# 工程编码（projectCode）
# MCP_PROJECT_CODE=
